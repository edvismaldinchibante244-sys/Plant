# Copie este arquivo para `.env` e ajuste os valores do SMTP.
# Para Gmail, use uma senha de app valida.

USE_SMTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=coloque_sua_senha_de_app
SMTP_SECURE=tls
SMTP_FROM="Sistema RestaurantESA <seu-email@gmail.com>"
SMTP_TIMEOUT=5
SMTP_DEBUG=0
